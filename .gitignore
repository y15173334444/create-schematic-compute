# Gradle
.gradle/
build/
*.jar
!build/libs/*.jar
!libs/*.jar
# Create 系列的 jar 内含 All Rights Reserved 资产，不随本仓库分发（见 docs/third-party-licenses.md §3 O4）。
# 放在上面两条 ! 之后，靠「后面的规则优先」生效 —— 即使有人把 jar 拷回 libs/ 也不会被误提交。
# Create's jars carry All Rights Reserved assets and must not be redistributed here; this
# guard wins over the negations above on purpose (last matching pattern wins).
libs/create-1.21.1-*.jar
libs/create-aeronautics-*.jar
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
.vscode/

# WorkBuddy（代理工作区数据，非项目源码 / agent workspace data, not project source）
.workbuddy/

# Minecraft dev
runs/
out/
/assets/
/META-INF/

# OS
.DS_Store
Thumbs.db

# Reference
texture_reference/


# Logs
*.log
*.hprof

# Dev-server runtime logs (rotated .gz not covered by *.log)
logs/

# Client run log captured for background launches (not covered by *.log)
runclient_log.txt

# Agent verify workspace (javac/tests scratch, not project source)
.tmp-verify/

# Python 字节码缓存（tools/ 下的 python 工具）
__pycache__/

# Sable 兼容性矩阵的版本仓库（tools/sable-compat/fetch_sable_jars.py 随取随建，不入库：
# 14 版数百 MB，且 PolyForm Shield 再分发受限，见 docs/third-party-licenses.md）
# Sable compat-matrix version store, rebuilt on demand by fetch_sable_jars.py and never
# committed (hundreds of MB; PolyForm Shield redistribution is restricted).
tools/sable-compat/jars/
